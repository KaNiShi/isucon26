# 開発向けサンプル。map は http block 内、location は既存 server block 内に配置する。
# ほかの API は既存の php-fpm :9000 への設定で処理する。
map $http_x_client_ip $isureal_client_ip {
    default $http_x_client_ip;
    "" $remote_addr;
}

location = /api/notifications {
    proxy_pass http://127.0.0.1:9002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Client-IP $isureal_client_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 3s;
    proxy_read_timeout 1h;
    proxy_send_timeout 15s;
}
